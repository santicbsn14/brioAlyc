# Variables de entorno de `api/contacto.ts` (formulario de la sección Contacto).
# Copiar a `.env.local` para desarrollo y cargar los valores reales en Vercel
# (Project Settings → Environment Variables). Nunca commitear valores reales.

# API key de Resend (https://resend.com/api-keys), usada para enviar el mail de contacto.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mail de Brio a donde llega cada consulta del formulario.
# TODO(Agus): confirmar el mail real, este es un valor de ejemplo.
CONTACTO_DESTINATARIO=contacto@briovalores.com

# ── Sanity (contenido del sitio; el Studio está en el repo hermano brio-studio) ──
# Todas opcionales. Son variables del navegador (prefijo VITE_): no poner nada secreto acá.

# Proyecto y dataset. Por defecto s4crxz9i / production (ver src/sanity/config.ts).
# VITE_SANITY_PROJECT_ID=s4crxz9i
# VITE_SANITY_DATASET=production

# CDN de Sanity: "true" solo en el entorno Production de Vercel. Con el CDN, lo que se publica
# en el Studio tarda unos segundos en verse; sin él (local y previews) se ve al recargar.
# Solo tiene efecto en un build de producción: con `vite dev` el CDN siempre está apagado.
# VITE_SANITY_USE_CDN=true

# Recuadros "Falta cargar en Sanity: …" en un build (con `vite dev` se ven siempre).
# "true" solo en el entorno Preview de Vercel; en Production nunca.
# VITE_MOSTRAR_FALTANTES=true
